{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug poisson-demo (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/../build/scratch/poisson-demo",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "waf: build",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
